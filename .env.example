REQUEST_LOG_RETENTION_DAYS=14
ALERT_RETENTION_DAYS=30
HEALTH_CHECK_RETENTION_DAYS=30
USAGE_EVENT_RETENTION_DAYS=60
METRIC_SNAPSHOT_RETENTION_DAYS=30
