ONLINE_SEARCH_MAX_RESULTS=3
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
DATABASE_URL=sqlite:///backend/data/hajihaz.db
BACKUP_DIR=backend/data/backups
BACKUP_RETENTION_DAYS=14
BACKUP_RETENTION_COUNT=12
BACKUP_INTERVAL_HOURS=24
INCLUDE_LOGS_IN_BACKUP=true
UPLOADS_DIR=backend/data/uploads
OCR_ENABLED=true
OCR_LANGUAGES=eng
TESSERACT_COMMAND=tesseract
PDFTOPPM_COMMAND=pdftoppm
UVICORN_LOG_PATH=logs/app/uvicorn.log
LOG_FILE_RETENTION_DAYS=21
ALERT_WEBHOOK_URL=
ALERT_EMAIL_HOST=
ALERT_EMAIL_PORT=587
ALERT_EMAIL_USER=
ALERT_EMAIL_PASSWORD=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
