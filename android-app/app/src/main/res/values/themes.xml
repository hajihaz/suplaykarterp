<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.HajiHazAI" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:statusBarColor">@color/surface_dark</item>
        <item name="android:navigationBarColor">@color/surface_dark</item>
        <item name="android:windowBackground">@color/surface_dark</item>
        <item name="colorPrimary">@color/brand_accent</item>
        <item name="colorPrimaryVariant">@color/brand_accent</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorOnPrimary">@color/button_text_dark</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>
    </style>

    <style name="Theme.HajiHazAI.Splash" parent="Theme.HajiHazAI">
        <item name="android:windowBackground">@color/splash_background</item>
    </style>

    <style name="Widget.HajiHazAI.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textAllCaps">false</item>
        <item name="backgroundTint">@color/brand_accent</item>
        <item name="android:textColor">@color/button_text_dark</item>
        <item name="cornerRadius">18dp</item>
    </style>

    <style name="Widget.HajiHazAI.Button.Secondary" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/brand_accent</item>
        <item name="android:textColor">@color/brand_accent</item>
        <item name="cornerRadius">18dp</item>
    </style>

</resources>
