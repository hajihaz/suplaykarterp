{
  "name": "suplaykart-staff",
  "private": true,
  "version": "1.0.0",
  "description": "Suplaykart Staff — Workforce OS. Single-file ERP wrapped as a PWA + Android app via Capacitor.",
  "license": "MIT",
  "homepage": "https://suplaykart-staff.vercel.app",
  "type": "module",
  "scripts": {
    "start":        "npx http-server . -p 5173 -c-1 -o",
    "serve":        "npx http-server . -p 5173 -c-1",
    "lint:html":    "echo 'no html-validate config — manual review only'",
    "cap:init":     "npx cap init 'Suplaykart Staff' com.suplaykart.staff --web-dir=.",
    "cap:android":  "npx cap add android && npx cap sync android",
    "cap:ios":      "npx cap add ios && npx cap sync ios",
    "cap:sync":     "npx cap sync",
    "cap:open":     "npx cap open android",
    "cap:build":    "cd android && ./gradlew assembleRelease && cd ..",
    "cap:bundle":   "cd android && ./gradlew bundleRelease && cd ..",
    "vercel:dev":   "npx vercel dev",
    "vercel:deploy":"npx vercel --prod"
  },
  "dependencies": {
    "@capacitor/android":     "^6.1.2",
    "@capacitor/app":         "^6.0.1",
    "@capacitor/core":        "^6.1.2",
    "@capacitor/geolocation": "^6.0.1",
    "@capacitor/preferences": "^6.0.2",
    "@capacitor/splash-screen":"^6.0.2",
    "@capacitor/status-bar":  "^6.0.1",
    "@capacitor/camera":      "^6.0.2",
    "@capacitor/filesystem":  "^6.0.1",
    "@capacitor/network":     "^6.0.2",
    "@capacitor/share":       "^6.0.2",
    "@capacitor/toast":       "^6.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.1.2",
    "http-server":    "^14.1.1",
    "vercel":         "^37.0.0"
  }
}
